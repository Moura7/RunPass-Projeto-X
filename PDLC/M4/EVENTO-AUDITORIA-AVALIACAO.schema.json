{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunPass ReviewAuditEvent - draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "eventType",
    "occurredAt",
    "expiresAt",
    "reviewId",
    "aggregateVersion",
    "correlationId",
    "before",
    "after"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "enum": [
        "ReviewCreated",
        "ReviewReplaced",
        "ReviewDeleted",
        "ReviewModerated"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewId": {
      "type": "string"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string"
    },
    "before": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "course",
            "kit",
            "medal",
            "hydration",
            "facilities",
            "safety",
            "valueForMoney"
          ],
          "properties": {
            "organization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "course": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "kit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "medal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "hydration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "facilities": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "safety": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "valueForMoney": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "after": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ratings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "course",
            "kit",
            "medal",
            "hydration",
            "facilities",
            "safety",
            "valueForMoney"
          ],
          "properties": {
            "organization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "course": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "kit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "medal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "hydration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "facilities": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "safety": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "valueForMoney": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$comment": "expiresAt must equal occurredAt + 60 days, enforced in code. before/after null for creation/deletion. No credentials, birth date or direct identity copy. Additional linkage for privacy deletion must be stored securely, not inferred from this schema."
}
